# EFEX216 — sunucu yönlendirmeleri (efex216.com, LiteSpeed/Apache)
# Eski sitenin adresleri yeni sayfalara kalıcı (301) yönlendirilir; Google sıralaması korunur.

RewriteEngine On

# Tek adres: www.efex216.com -> efex216.com
RewriteCond %{HTTP_HOST} ^www\.efex216\.com$ [NC]
RewriteRule ^(.*)$ https://efex216.com/$1 [R=301,L]

# Eski Türkçe sayfalar (eskiden kökteydi, artık /tr/ altında)
RewriteRule ^bizkimiz\.html$ /tr/bizkimiz.html [R=301,L]
